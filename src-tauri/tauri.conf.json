{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oviraptor",
  "version": "1.1.108",
  "identifier": "com.oviraptor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oviraptor",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://hackerone.com https://*.hackerone.com; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/workers/*.cjs",
      "resources/workers/BABEL_PARSER_LICENSE.txt",
      "resources/config/*",
      "resources/rules/*",
      "resources/capability_bundles/*",
      "resources/agent-host/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
