{
  "schemaVersion": 1,
  "note": "Builtin identification signals only. Independent user fingerprint packs are loaded at scan time. CVE knowledge and active exposure checks are distributed separately. Legacy rules default to matchMode any; use all for combined requirements.",
  "fingerprints": [
    {
      "id": "dedecms",
      "name": "DedeCMS 织梦",
      "setCookieRegex": ["(?i)DedeLoginTime", "(?i)DedeUserID"],
      "bodyRegex": ["(?i)power\\s*by\\s*dedecms", "(?i)dedecms", "/templets/", "/plus/count\\.php", "/plus/list\\.php"],
      "pathSignals": [
        { "path": "/data/admin/ver.txt", "status": [200], "bodyRegex": "^[0-9]{6,}" }
      ]
    },
    {
      "id": "wordpress",
      "name": "WordPress",
      "bodyRegex": ["/wp-content/", "/wp-includes/", "(?i)<meta[^>]+name=[\"']generator[\"'][^>]+WordPress"],
      "pathSignals": [
        { "path": "/wp-login.php", "status": [200], "bodyRegex": "(?i)user_login" }
      ]
    },
    {
      "id": "thinkphp",
      "name": "ThinkPHP",
      "headerRegex": { "X-Powered-By": "(?i)thinkphp" },
      "bodyRegex": ["(?i)thinkphp", "(?i)think_template"]
    },
    {
      "id": "drupal",
      "name": "Drupal",
