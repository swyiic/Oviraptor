{
  "schemaVersion": 1,
  "note": "Builtin starter fingerprints (Wappalyzer-style signals). A larger corpus is meant to be synced as a rule-pack; this is the vetted default set. Identification is signal-based: any matching signal identifies the product.",
  "fingerprints": [
    {
      "id": "dedecms",
      "name": "DedeCMS 织梦",
      "setCookieRegex": ["(?i)DedeLoginTime", "(?i)DedeUserID"],
