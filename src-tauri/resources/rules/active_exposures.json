{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "git-head",
      "title": "Git 仓库泄漏 (.git/HEAD)",
      "severity": "high",
      "appliesTo": ["http"],
      "path": "/.git/HEAD",
      "match": { "status": [200], "bodyRegex": "^(ref:\\s|[0-9a-f]{40})" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "git-config",
      "title": "Git 配置泄漏 (.git/config)",
      "severity": "high",
      "appliesTo": ["http"],
      "path": "/.git/config",
      "match": { "status": [200], "bodyContains": ["[core]"] },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "dotenv",
      "title": "环境变量文件泄漏 (.env)",
      "severity": "high",
      "appliesTo": ["http"],
      "path": "/.env",
      "match": { "status": [200], "bodyRegex": "(?m)^[A-Z][A-Z0-9_]{2,}=" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "svn-wc-db",
      "title": "SVN 工作副本泄漏 (.svn/wc.db)",
      "severity": "high",
      "appliesTo": ["http"],
      "path": "/.svn/wc.db",
      "match": { "status": [200], "bodyContains": ["SQLite format 3"] },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "ds-store",
      "title": "目录索引泄漏 (.DS_Store)",
      "severity": "medium",
      "appliesTo": ["http"],
      "path": "/.DS_Store",
      "match": { "status": [200], "bodyContains": ["Bud1"] },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "backup-sql",
      "title": "数据库备份泄漏 (backup.sql)",
      "severity": "high",
      "appliesTo": ["http"],
      "path": "/backup.sql",
      "match": { "status": [200], "bodyRegex": "(?i)(create table|insert into|drop table)" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "security-txt",
      "title": "security.txt 披露联系方式",
      "severity": "info",
      "appliesTo": ["http"],
      "path": "/.well-known/security.txt",
      "match": { "status": [200], "bodyRegex": "(?i)^contact:" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "dedecms-version",
      "title": "DedeCMS 版本信息泄漏 (/data/admin/ver.txt)",
      "severity": "low",
      "appliesTo": ["dedecms"],
      "path": "/data/admin/ver.txt",
      "match": { "status": [200], "bodyRegex": "^[0-9]{6,}" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "phpinfo",
      "title": "phpinfo() 信息泄漏",
      "severity": "medium",
      "appliesTo": ["http"],
      "path": "/phpinfo.php",
      "match": { "status": [200], "bodyRegex": "(?i)(phpinfo\\(\\)|<title>phpinfo)" }
    },
    {
      "id": "spring-actuator-env",
      "title": "Spring Boot Actuator env 暴露 (/actuator/env)",
      "severity": "high",
      "appliesTo": ["spring-boot"],
      "path": "/actuator/env",
      "match": { "status": [200], "bodyContains": ["propertySources"] },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "apache-server-status",
      "title": "Apache server-status 暴露 (/server-status)",
      "severity": "medium",
      "appliesTo": ["apache"],
      "path": "/server-status",
      "match": { "status": [200], "bodyRegex": "(?i)Apache Server Status" }
    },
    {
      "id": "druid-monitor",
      "title": "Druid 监控面板未授权暴露 (/druid/index.html)",
      "severity": "medium",
      "appliesTo": ["druid"],
      "path": "/druid/index.html",
      "match": { "status": [200], "bodyRegex": "(?i)druid\\s*stat" }
    },
    {
      "id": "swagger-ui",
      "title": "Swagger API 文档暴露 (/swagger-ui.html)",
      "severity": "low",
      "appliesTo": ["swagger"],
      "path": "/swagger-ui.html",
      "match": { "status": [200], "bodyRegex": "(?i)swagger" }
    },
    {
      "id": "nacos-console",
      "title": "Nacos 控制台可匿名访问 (/nacos/v1/console/server/state)",
      "severity": "medium",
      "appliesTo": ["nacos"],
      "path": "/nacos/v1/console/server/state",
      "match": { "status": [200], "bodyRegex": "(?i)version" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "weblogic-console",
      "title": "WebLogic 控制台暴露 (/console)",
      "severity": "medium",
      "appliesTo": ["weblogic"],
      "path": "/console/login/LoginForm.jsp",
      "match": { "status": [200], "bodyRegex": "(?i)weblogic" }
    },
    {
      "id": "openapi-v3-docs",
      "title": "OpenAPI/Swagger 接口清单暴露 (/v3/api-docs)",
      "severity": "low",
      "appliesTo": ["http"],
      "path": "/v3/api-docs",
      "match": { "status": [200], "bodyRegex": "(?i)\"openapi\"|\"swagger\"" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "openapi-v2-docs",
      "title": "Swagger 接口清单暴露 (/v2/api-docs)",
      "severity": "low",
      "appliesTo": ["http"],
      "path": "/v2/api-docs",
      "match": { "status": [200], "bodyRegex": "(?i)\"swagger\"\\s*:" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "spring-actuator-root",
      "title": "Spring Boot Actuator 端点清单暴露 (/actuator)",
      "severity": "medium",
      "appliesTo": ["http"],
      "path": "/actuator",
      "match": { "status": [200], "bodyContains": ["_links"] },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "spring-gateway-routes",
      "title": "Spring Cloud Gateway 路由暴露 (/actuator/gateway/routes) — 可枚举内网路由/潜在 SSRF",
      "severity": "high",
      "appliesTo": ["http"],
      "path": "/actuator/gateway/routes",
      "match": { "status": [200], "bodyRegex": "(?i)\"route_id\"|\"predicate\"|\"uri\"\\s*:" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    },
    {
      "id": "eureka-apps",
      "title": "Eureka 注册中心暴露 (/eureka/apps) — 泄漏内网服务清单",
      "severity": "medium",
      "appliesTo": ["http"],
      "path": "/eureka/apps",
      "match": { "status": [200], "bodyRegex": "(?i)<applications|\"application\"" }
    },
    {
      "id": "xxl-job-admin",
      "title": "XXL-JOB 调度中心登录面暴露 (/xxl-job-admin/)",
      "severity": "medium",
      "appliesTo": ["http"],
      "path": "/xxl-job-admin/",
      "match": { "status": [200], "bodyRegex": "(?i)xxl-job" }
    },
    {
      "id": "apollo-config-service",
      "title": "Apollo 配置中心服务暴露 (/services/config)",
      "severity": "medium",
      "appliesTo": ["http"],
      "path": "/services/config",
      "match": { "status": [200], "bodyRegex": "(?i)\"appName\"\\s*:\\s*\"apollo|homepageUrl" },
      "negateBodyContains": ["<html", "<!doctype", "<!DOCTYPE"]
    }
  ]
}
