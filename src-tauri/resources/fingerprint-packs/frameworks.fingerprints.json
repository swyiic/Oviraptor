  "fingerprints": [
    {
      "id": "component-symfony-profiler",
      "name": "Symfony Web Profiler",
      "condition": {
        "type": "all",
        "children": [
          {
            "type": "header",
            "name": "x-debug-token",
            "pattern": "(?i)^[0-9a-f]{6}$"
          },
          {
            "type": "header",
            "name": "x-debug-token-link",
            "pattern": "(?i)^https?://[^\\s]+/_profiler/[0-9a-f]{6}(?:[/?#]|$)"
          }
        ]
      }
    },
    {
      "id": "framework-aiohttp",
      "name": "aiohttp",
      "headerRegex": {
        "server": "(?i)^Python/[0-9]+\\.[0-9]+(?:\\.[0-9]+)?\\s+aiohttp/[0-9][0-9A-Za-z.+_-]*\\s*$"
      }
    },
    {
      "id": "framework-nextjs",
      "name": "Next.js",
      "condition": {
        "type": "header",
        "name": "x-powered-by",
        "pattern": "(?i)^Next\\.js\\s*$"
      }
    },
    {
      "id": "framework-nuxt",
      "name": "Nuxt",
      "condition": {
        "type": "header",
        "name": "x-powered-by",
        "pattern": "(?i)^Nuxt\\s*$"
      }
    },
    {
      "id": "framework-rocket",
      "name": "Rocket（Rust Web 框架）",
      "headerRegex": {
        "server": "^Rocket\\s*$"
      }
    },
    {
      "id": "framework-tornado",
      "name": "Tornado",
      "headerRegex": {
        "server": "(?i)^TornadoServer/[0-9][0-9A-Za-z.+_-]*\\s*$"
      }
    },
    {
      "id": "runtime-caddy",
      "name": "Caddy",
      "headerRegex": {
        "server": "(?i)^Caddy\\s*$"
      }
    },
    {
      "id": "runtime-hypercorn",
      "name": "Hypercorn",
      "headerRegex": {
        "server": "(?i)^hypercorn-(?:h11|h2|h3)\\s*$"
      }
    },
    {
      "id": "runtime-kestrel",
      "name": "ASP.NET Core Kestrel",
      "headerRegex": {
        "server": "(?i)^Kestrel\\s*$"
      }
    },
    {
      "id": "runtime-uvicorn",
