{
  "manifest": {
    "schemaVersion": 1,
    "id": "org.oviraptor.assets",
    "version": "1.2.16",
    "hostApi": "^1.0.0",
    "entry": "worker.mjs",
    "dataSchemaVersion": 2,
    "pages": [
      {
        "id": "home",
        "title": "Assets",
        "path": "page.html"
      }
    ],
    "permissions": [
      {
        "id": "inventory.write",
        "description": "inventory write"
      },
      {
        "id": "inventory.read",
        "description": "inventory read"
      },
      {
        "id": "inventory.exposure.read",
        "description": "Read project exposure aggregate counts only (runs/findings by severity and status). Never returns payload, evidence, credentials or raw responses."
      },
      {
        "id": "certificate.collect",
        "description": "在当前项目已确认范围内读取公开 TLS 证书、查询 CT 和 DNS/CNAME，创建、暂停和恢复持久自动补证任务；不获取页面、不调用付费测绘 API、不扩大确认范围。"
      },
      {
        "id": "inventory.discovery.run",
        "description": "在明确点击后启动 FOFA 被动首采，并按保存的 Hunter 开关，对已有真实证据和已确认范围执行精确分页补查；可消耗全部可用积分，逐页记录费用，未知请求不重发。此权限不确认归属或扩大探测范围。"
      },
      {
        "id": "inventory.exposure.details.read",
        "description": "Read bounded project exposure finding metadata for AI prioritization. Free-form titles are omitted; source URLs are reduced to origins; no raw evidence, credentials, page body or payload. Does not change review decisions."
      },
      {
        "id": "inventory.exposure.run",
        "description": "Explicitly start, resume or cancel passive exposure collection using the saved scope, sources and budgets. May contact external services; does not confirm ownership or remediate."
      }
    ],
    "tools": [
      {
        "name": "inventory_import",
        "description": "Import explicit inventory records into this app. Source/external ID is the only replacement key; no weak endpoint merge, ownership confirmation or scan authorization.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "externalId": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "host": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "link": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "ip": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "port": {
                    "type": "string",
                    "maxLength": 8
                  },
                  "protocol": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "domain": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "statusCode": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "probeOutcome": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "observedAt": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "externalId"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "source",
            "records"
          ],
          "additionalProperties": false
        },
        "permission": "inventory.write"
      },
      {
        "name": "inventory_stats",
        "description": "Count this project inventory and its synchronized local discovery seeds (certificate SHA-256 fingerprints, certificate names and other sources), including unknown saved statuses. Imported record count is not provider discovery completeness or current reachability.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "inventory_search",
        "description": "Read at most 20 imported records with an exact matching total and bound ID cursor. Literal metadata search; separate reads are not a durable snapshot.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 120
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "cursor": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "inventory_schema",
        "description": "Return the static whitelist of inventory tables and columns for this app. Does not query sqlite_master or live schema; agent-facing contract only.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "inventory_query",
        "description": "Paginated inventory read with whitelist filters (query/source/host/domain/protocol/statusCode/probeOutcome). Limit at most 100; bound cursor. No ad-hoc SQL.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filter": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "maxLength": 120
                },
                "source": {
                  "type": "string",
                  "maxLength": 128
                },
                "host": {
                  "type": "string",
                  "maxLength": 256
                },
                "domain": {
                  "type": "string",
                  "maxLength": 256
                },
                "protocol": {
                  "type": "string",
                  "maxLength": 32
                },
                "statusCode": {
                  "type": "string",
                  "maxLength": 16
                },
                "probeOutcome": {
                  "type": "string",
                  "maxLength": 64
                }
              },
              "additionalProperties": false
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cursor": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "project_overview",
        "description": "Host-bound project inventory overview: totals, probe/HTTP buckets, sources, and optional legacy snapshot availability. Not provider completeness or live reachability.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "insight_propose",
        "description": "Propose a whitelist insight patch (tags/note/labels/classification) for an inventory record. Does not write; returns proposalId for insight_commit after userConfirmed.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "inventoryRecordId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "fields": {
              "type": "object",
              "properties": {
                "tags": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "note": {
                  "type": "string",
                  "maxLength": 2048
                },
                "labels": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "classification": {
                  "type": "string",
                  "maxLength": 2048
                }
              },
              "additionalProperties": false
            },
            "baseVersion": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "inventoryRecordId",
            "fields"
          ],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "insight_commit",
        "description": "Commit a prior insight_propose after explicit userConfirmed. Writes inventory_insights in inventory.sqlite3. Idempotent on operationId. Fails with confirm_required without userConfirmed.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "proposalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "userConfirmed": {
              "type": "boolean"
            },
            "baseVersion": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "proposalId",
            "userConfirmed",
            "operationId"
          ],
          "additionalProperties": false
        },
        "permission": "inventory.write"
      },
      {
        "name": "exposure_overview",
        "description": "Host-bound project exposure aggregate: run counts and findings by severity/status only. No payload, evidence excerpt, request content, probe rules, credentials or raw responses.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.exposure.read"
      },
      {
        "name": "certificate_task_start",
        "description": "创建并开始证书补采持久任务：仅当前项目确认范围内、尚无指纹的 HTTPS 资产。省略 assetIds 会冻结全部符合条件的资产；支持 startPaused 仅建队列。返回 taskId 和进度；无需逐条模型调用。 When assetIds is supplied, assetIdNamespace is required: inventory means query/search row id, desktop means externalId from source=desktop-assets. Host validates and translates; never interchange independent numeric IDs. Omit both to process all eligible scope assets.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "assetIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1,
              "maxItems": 128
            },
            "workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 2,
              "maximum": 30
            },
            "startPaused": {
              "type": "boolean"
            },
            "assetIdNamespace": {
              "type": "string",
              "enum": [
                "inventory",
                "desktop"
              ]
            }
          },
          "additionalProperties": false
        },
        "permission": "certificate.collect"
      },
      {
        "name": "certificate_task_status",
        "description": "查看当前项目最近证书补采任务或指定 taskId 的持久进度、失败原因、成功资产数和去重指纹数。成功资产数不等于唯一证书数；重启后仍可读取。 启动结果未知时，使用原 operationId 只读查回已持久化的启动回执，与 taskId 互斥；未找到不等于未执行，不自动重发。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "certificate_task_pause",
        "description": "暂停当前项目证书任务；正在进行的 TLS 握手会先保存结果，之后不领取新资产。查看 status 确认 paused。",
        "inputSchema": {
          "type": "object",
          "required": [
            "taskId"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "retryFailed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "permission": "certificate.collect"
      },
      {
        "name": "certificate_task_resume",
        "description": "从当前项目证书任务的未完成项恢复，不重做已完成项；retryFailed=true 仅在明确重试失败项时使用。应用退出后需显式恢复。",
        "inputSchema": {
          "type": "object",
          "required": [
            "taskId"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "retryFailed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "permission": "certificate.collect"
      },
      {
        "name": "discovery_enrichment_start",
        "description": "启动当前项目已确认域名范围的持续免费补证：复用本地证书、查 CT、DNS/CNAME、补采 TLS，提炼新范围内名称并持续增量处理。持久队列逐项保存，用户暂停可恢复，运行中的任务重启后继续。不会调用 Hunter、不扩大确认范围、不恢复隔离或回收资产。返回共享任务 ID。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "continuous": {
              "type": "boolean"
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 900,
              "maximum": 86400
            },
            "workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "additionalProperties": false
        },
        "permission": "certificate.collect"
      },
      {
        "name": "discovery_enrichment_status",
        "description": "读取同一持久补证队列的状态、各阶段进度、近期详细错误和按证书指纹分组的实际冲突。与界面共享进度；不启动网络请求。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "discovery_enrichment_pause",
        "description": "暂停自动补证与持续发现，停止领取新项，当前免费请求完成保存；使用 status 确认已暂停。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false,
          "required": [
            "taskId"
          ]
        },
        "permission": "certificate.collect"
      },
      {
        "name": "discovery_enrichment_resume",
        "description": "恢复当前项目已暂停的持续发现任务，复用已保存进度；确认范围变化时拒绝恢复，须按新范围重新启动。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false,
          "required": [
            "taskId"
          ]
        },
        "permission": "certificate.collect"
      },
      {
        "name": "discovery_assist_start",
        "description": "启动或接续当前项目完整 AI 发现工作流：全量本地证据分组→AI提炼→范围建议→在聊天面板一次确认后自动免费补证。organization必须来自用户明确指定；已有任务复用进度和未知请求保护。调用后读一次status即返回，后台持续处理，不逐条模型轮询，新任务默认不使用Hunter；只能沿用户已保存的同项目付费开关接续，不能自行开启首采、Hunter或新增范围。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "organization": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            },
            "includeIsolated": {
              "type": "boolean"
            }
          },
          "required": [
            "organization"
          ],
          "additionalProperties": false
        },
        "permission": "inventory.write"
      },
      {
        "name": "discovery_assist_status",
        "description": "读取和原生AI发现界面共用的持久进度、目标单位、AI用量、证据队列及范围建议摘要；不启动模型或目标请求。后台进度和完整候选会在当前聊天面板自动更新，无需循环调用。",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "discovery_assist_pause",
        "description": "暂停当前项目AI证据整理/提炼和免费补证；已执行结果、原始模型回执、人工结论均保留，未知请求不会重放。",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.write"
      },
      {
        "name": "discovery_review_read",
        "description": "分页读取当前项目AI发现证据组的有限摘要、域名和单位证据；不获取页面、密钥或完整证书。runId必须来自status，不猜ID。结果缺证不等于无关；只有冲突需要人工审核。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "filter": {
              "type": "string",
              "enum": [
                "all",
                "actionable",
                "conflict",
                "evidence",
                "errors",
                "retain",
                "exclude"
              ]
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "search": {
              "type": "string",
              "maxLength": 253
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "discovery_scope_propose",
        "description": "读取本项目完整AI工作流已生成的范围建议摘要，并在聊天面板展示供用户一次确认。模型不能确认、扩大授权范围或代填userConfirmed；确认只由用户点击聊天面板按钮。没有建议时先读取status，不猜域名。",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "permission": "inventory.read"
      },
      {
        "name": "discovery_seed_list",
        "description": "读取当前项目种子台账：按独立证据状态、种子类型和关键词分页。包含首次发现轮次、历史基线、独立核验依据计数与人工已审样本统计；这些数量不是资产归属准确率。只读，不创建索引、不执行模型或付费查询。",
        "permission": "inventory.read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "maxLength": 160
            },
            "kind": {
              "type": "string",
              "enum": [
                "all",
                "domain",
                "fingerprint",
                "cname"
              ]
            },
            "trust": {
              "type": "string",
              "enum": [
                "all",
                "verified",
                "needs_evidence",
                "conflict",
                "excluded"
              ]
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "discovery_seed_detail",
        "description": "读取当前项目单一种子的分页证据与查询历史，包含首次/重复出现轮次和已保存Hunter费用回执。seedId必须来自discovery_seed_list；不确认归属、不启动查询。",
        "permission": "inventory.read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "seedId": {
              "type": "integer",
              "minimum": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "seedId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "exposure_findings",
        "description": "分页读取当前项目已保存暴露线索的脱敏元数据，优先级按实际严重性排序；返回真实总数及 nextCursor。没有原始证据或密钥；线索不等于已确认泄露，模型不得擅自确认/驳回。",
        "permission": "inventory.exposure.details.read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 10,
              "maximum": 20
            },
            "cursor": {
              "type": "string",
              "maxLength": 4096
            },
            "status": {
              "type": "string",
              "enum": [
                "",
                "new",
                "reviewing",
                "confirmed",
                "dismissed"
              ]
            },
            "search": {
              "type": "string",
              "maxLength": 120
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "exposure_finding",
        "description": "用本项目 exposure_findings 返回的 findingId 读取单条脱敏元数据。拒绝跨项目 ID，不返回证据正文、原 URL 查询串或凭据。",
        "permission": "inventory.exposure.details.read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "findingId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "findingId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "exposure_runs",
        "description": "分页读取本项目实际暴露面任务的进度、来源、错误和计数；不发起采集。历史计数不能证明当前可达或已完整覆盖。",
        "permission": "inventory.exposure.read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 10,
              "maximum": 20
            },
            "cursor": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "exposure_task_status",
