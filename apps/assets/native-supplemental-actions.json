{
  "schemaVersion": 1,
  "description": "Finite owned Assets presentation preferences, controlled import staging and native source-selection projection. Operators only, no model tools.",
  "actions": [
    {
      "name": "begin_exposure_import_upload",
      "scope": "project",
      "permission": "inventory.exposure.manage",
      "modelTool": false,
      "owner": "asset_service::exposure_uploads",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "operationId": {
                "type": "string",
                "maxLength": 80
              },
              "channel": {
                "type": "string",
                "maxLength": 80
              },
              "operator": {
                "type": "string",
                "maxLength": 80
              },
              "sourceDeclaration": {
                "type": "string",
                "maxLength": 65536
              },
              "declaredUrl": {
                "type": "string",
                "maxLength": 65536
              },
              "batchLabel": {
                "type": "string",
                "maxLength": 65536
              },
              "publicMaterial": {
                "type": "boolean"
              },
              "publicMaterialNote": {
                "type": "string",
                "maxLength": 65536
              },
              "extractedFrom": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "required": [
              "operationId",
              "channel",
              "operator",
              "sourceDeclaration"
            ],
            "additionalProperties": false
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 512
                },
                "format": {
                  "type": "string",
                  "maxLength": 80
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2097152
                },
                "sha256": {
                  "type": "string",
                  "maxLength": 64,
                  "minLength": 64
                }
              },
              "required": [
                "name",
                "format",
                "bytes",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "request",
          "files"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "put_exposure_import_chunk",
      "scope": "project",
      "permission": "inventory.exposure.manage",
      "modelTool": false,
      "owner": "asset_service::exposure_uploads",
      "inputSchema": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36
          },
          "fileIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19
          },
          "chunkIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "contentBase64": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "required": [
          "uploadId",
          "fileIndex",
          "chunkIndex",
          "contentBase64"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "exposure_import_upload_status",
      "scope": "project",
      "permission": "inventory.exposure.manage",
      "modelTool": false,
      "owner": "asset_service::exposure_uploads",
      "inputSchema": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36
          }
        },
        "required": [
          "uploadId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "commit_exposure_import_upload",
      "scope": "project",
      "permission": "inventory.exposure.manage",
      "modelTool": false,
      "owner": "asset_service::exposure_uploads",
      "inputSchema": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36
          },
          "expectedManifestDigest": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64
          }
        },
        "required": [
          "uploadId",
          "expectedManifestDigest"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "discard_exposure_import_upload",
      "scope": "project",
      "permission": "inventory.exposure.manage",
      "modelTool": false,
      "owner": "asset_service::exposure_uploads",
      "inputSchema": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36
          },
          "expectedManifestDigest": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64
          }
        },
        "required": [
          "uploadId",
          "expectedManifestDigest"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_asset_preferences",
      "scope": "application",
      "permission": "inventory.preferences.manage",
      "modelTool": false,
      "owner": "asset_service::preferences_service",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "save_asset_preferences",
      "scope": "application",
      "permission": "inventory.preferences.manage",
      "modelTool": false,
      "owner": "asset_service::preferences_service",
      "inputSchema": {
        "type": "object",
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          },
          "preferences": {
            "type": "object",
            "properties": {
              "columns": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 38,
                "items": {
                  "type": "string",
                  "enum": [
                    "projectName",
                    "assetKey",
                    "company",
                    "reviewTier",
                    "host",
                    "link",
                    "ip",
                    "port",
                    "protocol",
                    "domain",
                    "title",
                    "statusCode",
                    "probeOutcome",
                    "hasLogin",
                    "hasRegister",
                    "entrySeen",
                    "entryOpenedAt",
                    "probeEntryState",
                    "contentCategory",
                    "score",
                    "decision",
                    "note",
                    "ownershipStatus",
                    "ownershipConfidence",
                    "authorizationStatus",
                    "exposureEligible",
                    "ownershipReason",
                    "sentinelStatus",
                    "sentinelScanCount",
                    "sentinelSentAt",
                    "firstSeen",
                    "lastSeen",
                    "lastAlive",
                    "projectFirstSeen",
                    "projectLastSeen",
                    "lastRunId",
                    "isDeleted",
                    "deletedAt"
                  ]
                }
              },
              "columnWidths": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 38,
                "items": {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "enum": [
                        "projectName",
                        "assetKey",
                        "company",
                        "reviewTier",
                        "host",
                        "link",
                        "ip",
                        "port",
                        "protocol",
                        "domain",
                        "title",
                        "statusCode",
                        "probeOutcome",
                        "hasLogin",
                        "hasRegister",
                        "entrySeen",
                        "entryOpenedAt",
                        "probeEntryState",
                        "contentCategory",
                        "score",
                        "decision",
                        "note",
                        "ownershipStatus",
                        "ownershipConfidence",
                        "authorizationStatus",
                        "exposureEligible",
                        "ownershipReason",
                        "sentinelStatus",
                        "sentinelScanCount",
                        "sentinelSentAt",
                        "firstSeen",
                        "lastSeen",
                        "lastAlive",
                        "projectFirstSeen",
                        "projectLastSeen",
                        "lastRunId",
                        "isDeleted",
                        "deletedAt"
                      ]
                    },
                    "width": {
                      "type": "number",
                      "minimum": 68,
                      "maximum": 720
                    }
                  },
                  "required": [
                    "column",
                    "width"
                  ],
                  "additionalProperties": false
                }
              },
              "portalColumnsV1": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "agentScanMode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "quick",
                  "standard",
                  "deep",
                  null
                ]
              }
            },
            "required": [
              "columns",
              "columnWidths",
              "portalColumnsV1",
              "agentScanMode"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "expectedRevision",
          "preferences"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "prepare_scan_selection",
      "scope": "project",
      "permission": "inventory.read",
      "modelTool": false,
      "owner": "asset_service::scan_selection",
      "inputSchema": {
        "type": "object",
        "properties": {
          "assetIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep"
            ]
          }
        },
        "required": [
          "assetIds",
          "mode"
        ],
        "additionalProperties": false
      }
    }
  ]
}
