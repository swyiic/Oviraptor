{
  "manifest": {
    "schemaVersion": 1,
    "id": "org.oviraptor.hackerone",
    "version": "1.0.0",
    "hostApi": "^1.0.0",
    "entry": "worker.mjs",
    "dataSchemaVersion": 1,
    "pages": [{ "id": "home", "title": "HackerOne", "path": "page.html" }],
    "tools": [
      {
        "name": "programs_list",
        "description": "List locally cached HackerOne program summaries already stored for this app. Read-only; does not call remote APIs, sync accounts, or invent attack guidance.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": { "type": "string", "maxLength": 128 },
            "offset": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
          },
          "additionalProperties": false
        },
        "permission": "hackerone.read"
      },
      {
        "name": "program_get",
        "description": "Read one locally cached HackerOne program detail by handle. Read-only reference data; grants no network sync or exploitation capability.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "handle": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": ["handle"],
          "additionalProperties": false
        },
        "permission": "hackerone.read"
      }
    ],
    "permissions": [
      { "id": "hackerone.read", "description": "Read this app's locally cached HackerOne program records. Does not authorize network sync, credential use, or attack tooling." }
    ],
    "paired_skills": [
      { "name": "hackerone-operator-guide", "source": "docs/operator-guide.md", "required": false }
    ],
    "lifecycle": { "start": true, "stop": true }
  },
  "files": ["worker.mjs", "application.mjs", "page.html", "docs/operator-guide.md"],
  "vendorSdk": true
}
